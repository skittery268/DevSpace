# Base URL of the DevSpace backend, including the /api/v1 prefix.
# The backend mounts every router under /api/v1 (see server/app.js).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Origin of the backend, without the /api/v1 prefix.
# Only used to build the Google OAuth entry point, because that flow is a
# full-page browser redirect and cannot go through Axios.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Public origin of this storefront, used for canonical URLs, Open Graph tags,
# robots.txt and sitemap.xml. No trailing slash. In production this must be the
# real domain — canonical tags pointing at localhost de-index the site.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
